<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.logitics.erp.employeecertificate.mapper.EmployeeCertificateMapper">

    <select id="getEmployeeCertificateInfo"
        resultType="EmployeeCertificateInfoResponse"
    >
        SELECT * FROM employee_certificate ec
        WHERE ec.employee_id =
            (SELECT employee_id from employee e where e.employee_no = #{employeeNo})

    </select>


</mapper>