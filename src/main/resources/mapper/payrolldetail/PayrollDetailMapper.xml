<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.logitics.erp.payrolldetail.mapper.PayrollDetailMapper">

    <select id="findByAmountAndPayrollId">
        select * from payroll_detail
        where payroll_item_master_id = #{payrollItemMasterId}
        and amount = #{amount}
    </select>


</mapper>